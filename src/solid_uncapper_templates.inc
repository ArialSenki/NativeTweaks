// Built-in NativeTweaks template for Solid Uncapper.ini.
//
// Solid Uncapper ships no [NativeTweaks.*] template, so without this table its
// numeric settings would be left out of the generic editor. Entries match by
// key name only (any section), because the section a key lives in may move
// between Solid Uncapper versions. A [NativeTweaks.<Section>.<Key>] template
// written into the INI itself still wins over this table.
//
// Type "hidden" keeps internal bookkeeping keys out of the menu.
// "allowcustom" adds the INI's current value when it is not in Options=.

struct BuiltinTemplate {
    const char* key;
    const char* type;
    const char* minimum;
    const char* maximum;
    const char* step;
    const char* options;
    const char* category_en;
    const char* category_es;
    const char* label_es;
    const char* description_en;
    const char* description_es;
};

